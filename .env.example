# Copy to .env and set your keys (both have free tiers)
# NVIDIA: https://build.nvidia.com → API Keys
# Groq: https://console.groq.com → API Keys

VITE_NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_GROQ_MODEL=llama-3.1-70b-versatile
