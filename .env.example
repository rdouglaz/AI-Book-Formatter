# Copy to .env and set your keys (both have free tiers)
# NVIDIA: https://build.nvidia.com → API Keys
# Groq: https://console.groq.com → API Keys

VITE_NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2 best free NVIDIA endpoints:
# - nvidia/nemotron-3-ultra-550b-a55b    → 550B, 1M context (default, best quality)
# - nvidia/nemotron-3.5-lightning-30b-a3b → 30B A3B MoE (fastest, best availability)
VITE_NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Current Groq production models (Aug 2026+):
# - openai/gpt-oss-120b (default, 500 tps)
# - openai/gpt-oss-20b  (1000 tps)
VITE_GROQ_MODEL=openai/gpt-oss-120b
